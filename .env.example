# Copy this file to .env and fill in real values.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-random-value

# Use 'development' locally, 'production' on Cloud Run
FLASK_ENV=development

# GA4 web stream measurement ID (leave blank to disable analytics)
GOOGLE_ANALYTICS_MEASUREMENT_ID=

# Send events to GA4 DebugView while testing locally (true/false)
GOOGLE_ANALYTICS_DEBUG=false

# Optional contact CTAs. Leave blank to hide the corresponding CTA.
# Replace these placeholders only in your local/deployment environment.
CONTACT_EMAIL=
BOOKING_URL=

# Public production origin, without a trailing slash (for example, https://example.com)
SITE_URL=

# Search Console HTML-tag verification token only (not the full meta tag)
SEARCH_CONSOLE_VERIFICATION=
